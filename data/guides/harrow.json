    }
  ],
  "breakpoints": [
    {
      "slot": 4,
      "stat": "strength",
      "value": "흡수 피해 3,000(위력 100%) / 1,342(199%)",
      "effect": "코버넌트 치명 상한(몸통 +50%, 약점 +200%) 도달",
      "calc": "보너스 = (5% + 1.5% × 흡수 피해/100) × 위력, 몸통 상한 50%, 약점은 ×4로 200% 상한(동시 도달). 100%: (50−5) ÷ 1.5 × 100 = 3,000. 199%: (50/1.99 − 5) ÷ 1.5 × 100 = 1,342. 314%: 728. 북미 ninjase는 '약 2,000이면 상한'이라고 기술",
      "verified": true,
      "source": "https://wiki.warframe.com/w/Covenant"
    },
    {
      "slot": 1,
      "stat": "strength",
      "value": "적 4명(위력 199%) / 3명(314%)",
      "effect": "실드 1,150 → 실드 게이트 최대 2.5초",
      "calc": "적 1명당 실드 150 × 위력(오버실드 누적). 게이트는 실드 1,150에서 2.5초 상한(위키). 199%: 298.5 × 4 = 1,194. 314%: 471 × 3 = 1,413. 100%: 150 × 8 = 1,200(8명)",
      "verified": true,
      "source": "https://wiki.warframe.com/w/Shield_Gating"
    },
    {
      "slot": 2,
      "stat": "duration",
      "value": "229% (해로우 프라임, 실드+오버실드 가득)",
      "effect": "페넌스 1회 시전으로 최대 120초",
      "calc": "지속 = (4초 + 1.54초 × 소모 실드/100) × 지속. 해로우 프라임 실드 740 + 오버실드 상한 2,400(1,200 + 패시브 1,200) = 3,140 → 4 + 48.36 = 52.36초 × 2.29 = 120초. 일반 해로우(실드 555): 49.5초 → 242% 필요. 재시전으로 시간 누적 가능",
      "verified": true,
      "source": "https://wiki.warframe.com/w/Penance"
    },
    {
      "slot": 3,
      "stat": "efficiency",
      "value": "채널 125(위력 199%·효율 45%) / 79(위력 314%)",
      "effect": "튜러블 약점 처치 1회당 에너지 100",
      "calc": "킬당 = 1 + 채널량 × 15% ÷ (2 − 효율) × 위력, 약점 처치 ×4(위키 예: 위력·효율 130%, 25 채널 → 7.96). 약점 100 → 킬당 25 → 채널 = 24 × 1.55 ÷ (0.15 × 1.99) = 124.6. 위력 314%: 24 × 1.55 ÷ 0.471 = 79. 효율 175%면 분모 0.25로 같은 채널에서 6.2배",
      "verified": true,
      "source": "https://wiki.warframe.com/w/Thurible"
    },
    {
      "slot": 1,
      "stat": "strength",
      "value": "328%(코로시브 프로젝션 1개) / 400%",
      "effect": "이식 필리지 1회로 방어력·실드 100% 제거",
      "calc": "제거율 = 25% × 위력(이식판도 같고 비용만 에너지 50) → 100 ÷ 25 = 400%. 코로시브 프로젝션 18% 가산: 18 + 25 × 3.28 = 100%(위키 명시). 디시 441482는 타우 빨강 2개 또는 일반 빨강 3개로 맞춤",
      "verified": true,
      "source": "https://wiki.warframe.com/w/Pillage"
    }
  ],
  "mechanics": [
    {
      "text": "프라이머리 오버차지(최대 에너지 1,000에서 멀티샷 +350%, 현재 에너지 90% 이상 필요)를 3번 튜러블로 유지: 프라임드 플로우만으로는 최대 에너지 541 → 헬스 컨버전(+오브 동반자)+아케인 배터리로 1,000 돌파. 오버차지 유지를 위해 3번은 이식 금지(프라이머리 불워크를 쓰면 헬스 컨버전만으로 충족돼 3번 이식 가능)",
      "status": "작성자 실험",
      "source": "https://gall.dcinside.com/mgallery/board/view/?id=ordis&no=441482",
      "date": "2026-01-25"
    },
    {
      "text": "아콘 인텐시파이는 2번 페넌스 흡혈 회복으로도 발동",
      "status": "작성자",
      "source": "https://gall.dcinside.com/mgallery/board/view/?id=ordis&no=400510",
      "date": "2025-05-03"
    },
    {
      "text": "엘리트 맹습에서는 이식 써멀 선더를 1번 자리에 넣어야 어빌리티가 잠기지 않음(거리>>>위력>지속, 3번 에너지 40이면 블라인드 레이지도 가능)",
      "status": "작성자",
      "source": "https://gall.dcinside.com/mgallery/board/view/?id=ordis&no=447800",
      "date": "2026-03-16"
    },
    {
      "text": "아케인 컨센트레이션은 어빌리티 사용 후 3초 동안 지속 +60%이고 두 번째 어빌부터 적용",
      "status": "작성자",
      "source": "https://gall.dcinside.com/mgallery/board/view/?id=ordis&no=432936",
      "date": "2025-12-14"
    },
    {
      "text": "이식 레메디움은 시전 중 무적(시전 속도 0% 기준 약 1.5초)이라 시전 속도가 낮을수록 무적이 길고, 체력을 먼저 채운 뒤 남는 양을 오버실드로 바꿔 카탈라이징 실드와 묶으면 브리프 리스파이트 없이 실드 게이팅",
      "status": "작성자",
      "source": "https://gall.dcinside.com/mgallery/board/view/?id=ordis&no=435390",
      "date": "2025-12-23"
    }
  ],
